#!/usr/bin/env bash
# Stub `gh` for tools/agentic/tests. Answers from files in $GH_FIXTURES and logs
# every call to $GH_FIXTURES/calls.log.
#   pr view               pr-view.json (fails if pr-view.fail exists, or if
#                         merge-state.fail exists and mergeStateStatus is asked)
#   pr merge              fails if --match-head-commit differs from merge-head
#                         (the head at merge time; default: pr-view.json's);
#                         on success writes the merged SHA to merged
#   pr comment            logged; the fake clock's time goes to comment-times
#   pr view --json mergeStateStatus (that field alone)
#                         pops the first line of merge-state-seq, if any, as
#                         the state (a state that changes between reads)
#   api graphql           a query with resolveReviewThread logs its `id=` to
#                         resolved (fails if graphql-resolve.fail exists);
#                         any other query is served from graphql-threads.<page>.json
#                         (fails if graphql-threads.fail exists)
#   api repos/O/R/<path>  api/<path with / as _>.<page>.json; every page with
#                         --paginate, only page 1 without; fails if
#                         api/<name>.fail exists; [] when there are no pages
# --jq is applied to each page, as real gh does. With a `block` file every call
# hangs instead (see below).
set -u
fixtures=${GH_FIXTURES:?GH_FIXTURES is not set}
printf '%s\n' "$*" >>"$fixtures/calls.log"

# A stalled gh: with a `block` fixture every call hangs (in a child, as a real
# gh's helpers would) far longer than any budget, recording its pids.
if [ -e "$fixtures/block" ]; then
    sleep 300 &
    printf '%s\n' "$$" "$!" >>"$fixtures/blocked.pids"
    wait
    exit 1
fi

jq_expr=""
paginate=0
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --jq) jq_expr=$2; shift 2 ;;
        --paginate) paginate=1; shift ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]}"

emit() {
    if [ -n "$jq_expr" ]; then jq -r "$jq_expr" "$1"; else cat "$1"; fi
}

case "$1 ${2:-}" in
    "pr view")
        [ -e "$fixtures/pr-view.fail" ] && { echo "stub gh: pr view failed" >&2; exit 1; }
        if [ -e "$fixtures/merge-state.fail" ] && [[ " ${args[*]} " == *mergeStateStatus* ]]; then
            echo "stub gh: merge state lookup failed" >&2; exit 1
        fi
        if [ "${args[*]: -2}" = "--json mergeStateStatus" ] && [ -s "$fixtures/lookup-sleep" ]; then
            sleep "$(cat "$fixtures/lookup-sleep")" # a slow state lookup, in real seconds
        fi
        if [ "${args[*]: -2}" = "--json mergeStateStatus" ] && [ -s "$fixtures/merge-state-seq" ]; then
            jq -n --arg s "$(head -n1 "$fixtures/merge-state-seq")" '{mergeStateStatus: $s}' \
                >"$fixtures/state-now.json"
            sed -i 1d "$fixtures/merge-state-seq"
            emit "$fixtures/state-now.json"
        else
            emit "$fixtures/pr-view.json"
        fi
        ;;
    "api graphql")
        if [[ " ${args[*]} " == *resolveReviewThread* ]]; then
            [ -e "$fixtures/graphql-resolve.fail" ] && { echo "stub gh: resolve failed" >&2; exit 1; }
            for arg in "${args[@]}"; do
                case "$arg" in id=*) printf '%s\n' "${arg#id=}" >>"$fixtures/resolved" ;; esac
            done
            exit 0
        fi
        [ -e "$fixtures/graphql-threads.fail" ] && { echo "stub gh: HTTP 502 on graphql" >&2; exit 1; }
        shopt -s nullglob
        pages=("$fixtures"/graphql-threads.*.json)
        if [ "${#pages[@]}" = 0 ]; then
            echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]}}}}}' \
                >"$fixtures/graphql-empty.json"
            pages=("$fixtures/graphql-empty.json")
        fi
        [ "$paginate" = 1 ] || pages=("${pages[0]}")
        for page in "${pages[@]}"; do emit "$page"; done
        ;;
    "pr merge")
        want=""
        while [ $# -gt 0 ]; do
            [ "$1" = --match-head-commit ] && want=$2
            shift
        done
        if [ -e "$fixtures/merge-head" ]; then
            actual=$(cat "$fixtures/merge-head")
        else
            actual=$(jq -r .headRefOid "$fixtures/pr-view.json")
        fi
        if [ -n "$want" ] && [ "$want" != "$actual" ]; then
            echo "stub gh: head is $actual, not $want" >&2
            exit 1
        fi
        printf '%s\n' "$actual" >"$fixtures/merged"
        ;;
    "pr comment")
        # Record the fake clock's time, if any, so tests can see when it posted.
        [ -e "$fixtures/clock" ] && cat "$fixtures/clock" >>"$fixtures/comment-times"
        ;;
    "api "*)
        path=${2#repos/*/*/}
        name=${path//\//_}
        [ -e "$fixtures/api/$name.fail" ] && { echo "stub gh: HTTP 502 on $2" >&2; exit 1; }
        shopt -s nullglob
        pages=("$fixtures/api/$name".*.json)
        if [ "${#pages[@]}" = 0 ]; then
            echo '[]' >"$fixtures/empty.json"
            pages=("$fixtures/empty.json")
        fi
        [ "$paginate" = 1 ] || pages=("${pages[0]}")
        for page in "${pages[@]}"; do emit "$page"; done
        ;;
    *) echo "stub gh: unhandled: ${args[*]}" >&2; exit 1 ;;
esac
